# ── Shopify ───────────────────────────────────────────────────────────────
# Your store's *.myshopify.com domain (not your custom domain)
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Admin API version to call. Keep this current — see https://shopify.dev/docs/api/admin-graphql
SHOPIFY_API_VERSION=2026-01

# From your app in the Shopify Dev Dashboard > API credentials.
# CLIENT_ID + CLIENT_SECRET are only needed once, to run scripts/install.js.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Scopes requested during install (comma-separated, no spaces)
SHOPIFY_SCOPES=read_orders,write_orders

# Printed out by `npm run install:shopify` after you approve the install.
SHOPIFY_ADMIN_ACCESS_TOKEN=

# Public HTTPS base URL this server is reachable at once deployed
# (used by scripts/register-webhook.js to build the callback URL).
APP_BASE_URL=https://your-app.example.com

# ── Slack ─────────────────────────────────────────────────────────────────
# Bot User OAuth Token from api.slack.com/apps > OAuth & Permissions (starts with xoxb-)
SLACK_BOT_TOKEN=

# From api.slack.com/apps > Basic Information > App Credentials
SLACK_SIGNING_SECRET=

# The channel to post order alerts into. Right-click the channel in Slack ->
# View channel details -> scroll down for the Channel ID (starts with C).
SLACK_CHANNEL_ID=

# ── Server ───────────────────────────────────────────────────────────────
PORT=3000
